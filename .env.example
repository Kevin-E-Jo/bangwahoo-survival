# Supabase Postgres
# DATABASE_URL: 앱 런타임이 쓰는 연결(pgbouncer 풀링). RLS가 실제로 걸리려면
#   BYPASSRLS 권한이 없는 app_user role을 써야 한다 (supabase/rls.sql 참고).
#   supabase 기본 postgres role은 슈퍼유저라 RLS를 우회하므로 여기 쓰면 안 됨.
DATABASE_URL="postgresql://app_user:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL: `prisma migrate`/`db push` 전용, 풀링 없이 직결. 스키마를
#   생성/변경해야 하므로 소유자 role(postgres)을 쓴다.
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32 로 생성"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 이메일 매직링크 (SMTP)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="방과후 서바이벌 <noreply@example.com>"
